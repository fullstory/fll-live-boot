[Unit]
ConditionPathExists=|/var/lib/fll/ssh_authorized_keys
ConditionCredential=|fll.ssh.authorized_keys
Description=Live SSH Access Service
DefaultDependencies=no
Before=shutdown.target ssh.service
Conflicts=shutdown.target
After=fll-home.service

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/default/distro
ImportCredential=fll.ssh.authorized_keys
ExecStart=/usr/share/fll-live-initscripts/fll_sshd
Restart=no

[Install]
WantedBy=ssh.service
